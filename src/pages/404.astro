---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
	<section class="content-section" aria-labelledby="not-found-title">
		<div class="page-container">
			<header class="editorial-page-header">
				<p class="eyebrow">404</p>
				<h1 id="not-found-title">Page not found.</h1>
				<p>The page you're looking for doesn't exist or may have moved.</p>
			</header>

			<nav class="about-links" aria-label="404 page navigation">
				<a class="text-link" href="/">Back to home <span aria-hidden="true">→</span></a>
				<a class="text-link" href="/projects">View projects <span aria-hidden="true">→</span></a>
			</nav>
		</div>
	</section>
</BaseLayout>

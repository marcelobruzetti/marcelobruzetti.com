---
import NoteRow from '../components/presentation/NoteRow.astro';
import ProjectRow from '../components/presentation/ProjectRow.astro';
import SectionHeading from '../components/presentation/SectionHeading.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const publicProjects = await getCollection('projects', ({ data }) => !data.draft);
const sortProjects = (a: (typeof publicProjects)[number], b: (typeof publicProjects)[number]) =>
	(a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER) ||
	a.id.localeCompare(b.id);
const projects = publicProjects.filter(({ data }) => data.kind === 'project').sort(sortProjects);
const experiments = publicProjects.filter(({ data }) => data.kind === 'experiment').sort(sortProjects);
---

<BaseLayout>
	<section>
		<div class="page-container">
		<section class="hero" aria-labelledby="page-title">
			<h1 id="page-title">Marcelo Bruzetti</h1>
			<p class="hero-role">Senior Software Engineer</p>
			<p class="hero-summary">
				Building backend systems, distributed architectures, and data-intensive applications.
			</p>
			<div class="hero-links">
				<a class="text-link" href="#selected-work">View my work <span aria-hidden="true">→</span></a>
				<a class="text-link" href="#engineering-notes">Read my notes <span aria-hidden="true">→</span></a>
			</div>
			<ul class="social-links" aria-label="Social profiles">
				<li>
					<a
						href={site.social.github.url}
						target="_blank"
						rel="noopener noreferrer"
						title="GitHub (opens in a new tab)"
						aria-label="GitHub (opens in a new tab)"
					>
						<SocialIcon name="github" />
					</a>
				</li>
				<li>
					<a
						href={site.social.linkedin.url}
						target="_blank"
						rel="noopener noreferrer"
						title="LinkedIn (opens in a new tab)"
						aria-label="LinkedIn (opens in a new tab)"
					>
						<SocialIcon name="linkedin" />
					</a>
				</li>
			</ul>
		</section>
		</div>
	</section>

	<section
		id="selected-work"
		class="content-section content-section--surface"
		aria-labelledby="selected-work-title"
	>
		<div class="page-container">
			<SectionHeading id="selected-work-title" index="01" title="Selected Work" />
			<div class="editorial-list">
				{
					projects.map((project, index) => (
						<ProjectRow
							number={String(index + 1).padStart(2, '0')}
							name={project.data.title}
							type={project.data.category ?? ''}
							description={project.data.description}
							technologies={project.data.technologies}
							featured={project.data.featured}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section id="engineering-notes" class="content-section" aria-labelledby="engineering-notes-title">
		<div class="page-container">
			<SectionHeading id="engineering-notes-title" index="02" title="Engineering Notes" />
			<div class="editorial-list">
				<NoteRow
					title="Rate Limiting in Distributed Systems"
					category="System Design"
					date="Oct 2026"
					readingTime="8 min read"
					summary="A practical framework for choosing limits, coordination strategies, and failure behavior."
				/>
				<NoteRow
					title="Caching Strategies and Their Trade-offs"
					category="System Design"
					date="Oct 2026"
					readingTime="6 min read"
					summary="How cache placement, invalidation, and consistency shape system behavior."
				/>
			</div>
		</div>
	</section>

	<section class="content-section content-section--surface" aria-labelledby="experiments-title">
		<div class="page-container">
			<SectionHeading id="experiments-title" index="03" title="Experiments" />
			<div class="experiments-list">
				{
					experiments.map((experiment, index) => (
						<article class="experiment-row">
							<p class="metadata">Experiment / {String(index + 1).padStart(2, '0')}</p>
							<h3>{experiment.data.title}</h3>
							<p>{experiment.data.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>

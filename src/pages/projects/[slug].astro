---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectStatusLabels } from '../../utils/project-status';

interface Props {
	project: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
	const projects = await getCollection(
		'projects',
		({ data }) => !data.draft && data.kind === 'project',
	);

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
	<article class="project-detail content-section">
		<div class="page-container">
			<nav class="project-back-link" aria-label="Project navigation">
				<a class="text-link" href="/projects"><span aria-hidden="true">←</span> Back to projects</a>
			</nav>

			<header class="project-detail-header">
				<p class="eyebrow">Engineering Project</p>
				<h1>{project.data.title}</h1>
				<p class="project-detail-description">{project.data.description}</p>

				{
					(project.data.category || project.data.status || project.data.technologies.length > 0) && (
						<dl class="project-detail-meta">
							{project.data.category && (
								<div>
									<dt>Category</dt>
									<dd>{project.data.category}</dd>
								</div>
							)}
							{project.data.status && (
								<div>
									<dt>Status</dt>
									<dd>{projectStatusLabels[project.data.status]}</dd>
								</div>
							)}
							{project.data.technologies.length > 0 && (
								<div>
									<dt>Technologies</dt>
									<dd>{project.data.technologies.join(' · ')}</dd>
								</div>
							)}
						</dl>
					)
				}

				{
					(project.data.repositoryUrl || project.data.liveUrl) && (
						<ul class="project-detail-links" aria-label="Project links">
							{project.data.repositoryUrl && (
								<li><a class="text-link" href={project.data.repositoryUrl}>Repository</a></li>
							)}
							{project.data.liveUrl && (
								<li><a class="text-link" href={project.data.liveUrl}>Visit project</a></li>
							)}
						</ul>
					)
				}
			</header>

			<div class="long-form-content">
				<Content />
			</div>
		</div>
	</article>
</BaseLayout>

---
import { site } from '../../data/site';
import Navigation from './Navigation.astro';
---

<header class="border-b border-[color:var(--color-border)]">
	<div class="mx-auto flex max-w-5xl flex-col gap-4 px-5 py-5 sm:flex-row sm:items-center sm:justify-between">
		<a href="/" class="font-medium text-[color:var(--color-text)] no-underline">
			{site.name}
		</a>
		<Navigation />
	</div>
</header>

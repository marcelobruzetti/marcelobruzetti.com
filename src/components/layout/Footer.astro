---
import { site } from '../../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-border)]">
	<div class="page-container flex flex-col gap-1 py-8 text-sm text-[color:var(--color-text-muted)] sm:flex-row sm:items-center sm:justify-between">
		<p>&copy; {currentYear} {site.name}</p>
		<p>{site.role}</p>
	</div>
</footer>

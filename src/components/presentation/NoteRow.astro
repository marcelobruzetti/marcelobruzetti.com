---
interface Props {
	title: string;
	category: string;
	date: string;
	description: string;
	readingTime?: string;
	href?: string;
}

const { title, category, date, description, readingTime, href } = Astro.props;
const metadata = [category, date, readingTime].filter(Boolean);
---

<article class="note-row">
	<div>
		<p class="metadata">{metadata.join(' · ')}</p>
		<h3>{href ? <a class="note-title-link" href={href}>{title}</a> : title}</h3>
	</div>
	<div class="note-row-details">
		<p class="note-row-summary">{description}</p>
		{href && <a class="note-link" href={href} aria-label={`Read ${title}`}>Read note <span aria-hidden="true">→</span></a>}
	</div>
</article>

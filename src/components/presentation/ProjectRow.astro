---
interface Props {
	number: string;
	name: string;
	type: string;
	description: string;
	technologies: string;
	featured?: boolean;
}

const { number, name, type, description, technologies, featured = false } = Astro.props;
---

<article class:list={['project-row', { 'project-featured': featured }]}>
	<p class="project-number">{number}</p>
	<div>
		<h3>{name}</h3>
		<p class="project-type">{type}</p>
		<p class="row-description">{description}</p>
	</div>
	<div class="project-details">
		<p class="metadata">{technologies}</p>
		<p class="project-link">Explore project <span aria-hidden="true">→</span></p>
	</div>
</article>

---
import { getProjectStatusLabel, type ProjectStatus } from '../../utils/project-status';

interface Props {
	number: string;
	name: string;
	type: string;
	status?: ProjectStatus;
	description: string;
	technologies: string[];
	featured?: boolean;
	href?: string;
}

const { number, name, type, status, description, technologies, featured = false, href } = Astro.props;
const projectMetadata = [type, getProjectStatusLabel(status)].filter(Boolean);
---

<article class:list={['project-row', { 'project-featured': featured }]}>
	<p class="project-number">{number}</p>
	<div>
		<h3>
			{href ? <a class="project-title-link" href={href}>{name}</a> : name}
		</h3>
		{projectMetadata.length > 0 && <p class="project-type">{projectMetadata.join(' · ')}</p>}
		<p class="row-description">{description}</p>
	</div>
	<div class="project-details">
		<p class="metadata">{technologies.join(' · ')}</p>
		{
			href ? (
				<a class="project-link" href={href} aria-label={`Explore ${name}`}>
					Explore project <span aria-hidden="true">→</span>
				</a>
			) : (
				<p class="project-link">Explore project <span aria-hidden="true">→</span></p>
			)
		}
	</div>
</article>
